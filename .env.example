# ANexus environment configuration
# Copy this file to `.env` (or export these variables) and fill in your keys.
# No keys are required to run the app: each signed-in user supplies their own
# keys on the Settings page (stored encrypted server-side), and with
# `SIMULATE_LLM=true` the whole pipeline runs offline.

# ---- Providers (optional; per-user keys on the Settings page take precedence) ----
# These act as a shared fallback for accounts that have not saved their own keys,
# and as the defaults for the evaluation harness. Chain: NVIDIA -> Gemini -> Groq.
NVIDIA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Model overrides (optional) ----
# Current defaults (Sept 2026): NVIDIA meta/llama-3.3-70b-instruct, Gemini
# gemini-3.8-flash, Groq openai/gpt-oss-120b.
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b

# ---- Auth / multi-tenancy ----
# Passphrase for the per-user credential vault (any string). Required to SAVE
# credentials on the Settings page; changing it makes previously stored
# credentials unreadable (they must be re-entered).
ANEXUS_SECRET_KEY=
# Friendly provider label shown on the login screen (the real OIDC client config
# lives in the [auth] block of .streamlit/secrets.toml).
# ANEXUS_AUTH_PROVIDER_NAME=Google
# Local-development escape hatch: skip OIDC and act as a local auto-provisioned
# user. NEVER enable this in a deployed environment.
# ANEXUS_AUTH_DISABLED=false
# ANEXUS_DEV_EMAIL=dev@localhost

# ---- Cloud storage (S3-compatible; optional defaults for the cloud importer) ----
# Users normally enter these on the Settings page; these are deployment defaults.
# S3_ENDPOINT_URL=https://minio.example.com   # blank = real AWS S3
# S3_REGION=us-east-1

# ---- Privacy / security ----
# PII_SCORE_THRESHOLD=0.4
# SPACY_MODEL=en_core_web_sm

# ---- Web / cloud importer limits (optional overrides) ----
# WEB_MAX_PAGES=20
# WEB_FETCH_TIMEOUT_S=15
# WEB_MAX_BYTES=2000000
# CLOUD_MAX_FILES=50

# ---- Ingestion fallback engines (optional; see requirements-ocr.txt) ----
# The baseline (PyMuPDF plain text + Tesseract OCR) needs no configuration and is
# always the primary. These pick the primary engine; the other engine is used
# automatically when the primary is unavailable or returns too little text.
# ANEXUS_PDF_TEXT_ENGINE=pymupdf     # pymupdf (default) | pymupdf4llm
# ANEXUS_OCR_ENGINE=tesseract        # tesseract (default) | rapidocr

# ---- Text cleaning / preprocessing (optional overrides) --------------------
# Unicode NFKC + control/zero-width cleanup is always on (no flag). These tune
# the optional parts around it.
# Join words split by a hyphen at a line break ("loan ac-\ncount" -> "loan account").
# ANEXUS_NORMALIZE_DEHYPHENATE=true
# Strip Markdown relics from layout-aware extraction: "auto" strips them only for
# the pymupdf4llm engine; true/false force it on/off for every text source.
# ANEXUS_STRIP_MARKDOWN=auto
# Reject a page whose alphanumeric ratio (over non-space chars) is below this and
# retry it with the next engine (pymupdf4llm) or OCR. 0.5 is conservative.
# ANEXUS_OCR_GIBBERISH_MIN_ALNUM_RATIO=0.5

# ---- Scale / batching (tunable for larger corpora) --------------------------
# Chunks are written to Chroma in batches of this size; reads of the whole
# corpus paginate in chunks of this size. Only relevant for very large corpora.
# ANEXUS_CHROMA_ADD_BATCH_SIZE=512
# ANEXUS_CHROMA_GET_BATCH_SIZE=1000

# ---- Multilingual search (optional override) --------------------------------
# Which embedding model to load. The default (BGE-large-en) is English-oriented;
# pick e.g. jinaai/jina-embeddings-v3 or BAAI/bge-m3 for multilingual corpora.
# NOTE: changing this re-embeds nothing automatically — the vector store must be
# rebuilt for the new model to apply (existing vectors remain in the old space).
# ANEXUS_EMBEDDING_MODEL_NAME=BAAI/bge-large-en

# ---- Table extraction (optional; requires pdfplumber from requirements-ocr.txt) -
# Pages whose layout text is thin/jumbled are tried with pdfplumber table
# extraction before OCR. "auto" (default) engages it only on table-like pages;
# "on" always; "off" never.
# ANEXUS_PDF_TABLE_EXTRACTION=auto

# ---- Dedup / data quality (optional) -----------------------------------------
# When a file's content hash matches an existing document uploaded under a
# different name: "skip" (default) informs the user and ingests nothing;
# "replace" removes the earlier document and re-adds it under the new name.
# ANEXUS_DEDUP_ACTION=skip

# ---- Over-cleaning safeguards / boilerplate removal (optional) ---------------
# Drop lines repeated across most pages (running headers/footers/page stamps).
# "auto" (default) | "off". Conservative: only multi-page docs, never money
# amounts or labelled fields, and never leaves a page empty.
# ANEXUS_BOILERPLATE_REMOVAL=auto
# ANEXUS_BOILERPLATE_MIN_PAGES=3
# ANEXUS_BOILERPLATE_MIN_PAGE_FRACTION=0.6
# ANEXUS_BOILERPLATE_MIN_LINE_CHARS=12
# A page keeping less than this fraction of its raw text is flagged as heavily
# cleaned (reported, never dropped).
# ANEXUS_MIN_PAGE_CONTENT_RATIO=0.15
# Drop chunks shorter than this. OFF by default (0) because chunker tail
# fragments can be legitimately short; set e.g. 20 to opt in.
# ANEXUS_MIN_CHUNK_CHARS=0
# "conservative" (default) is the only profile today; reserved for an aggressive
# opt-in profile later.
# ANEXUS_CLEANING_PROFILE=conservative

# ---- Embedded metadata (optional) --------------------------------------------
# Attach document properties (title/author/created) from PDF/DOCX/XLSX/PPTX to
# page metadata when present.
# ANEXUS_EXTRACT_EMBEDDED_METADATA=true

# ---- Evaluation / CI ----
# Set to true to avoid any provider API call (uses the simulated LLM).
SIMULATE_LLM=false
# Set to 1 to run real-model tests that download the ~1.3 GB BGE embedder.
# ANEXUS_RUN_REAL_TESTS=0
