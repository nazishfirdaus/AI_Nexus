# ANexus environment configuration
# Copy this file to `.env` (or export these variables) and fill in your keys.
# No keys are required to run the app: the pipeline gracefully falls back to the
# simulated LLM when `SIMULATE_LLM=true`, which the test suite and CI rely on.

# ---- Providers (optional; the pipeline tries them in fallback order) ----
# Provider chain: NVIDIA -> Gemini -> Groq. The semantic router may reorder the
# first choice depending on query intent.
NVIDIA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Model overrides (optional) ----
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# ---- Privacy / security ----
# PII_SCORE_THRESHOLD=0.4
# SPACY_MODEL=en_core_web_sm

# ---- Evaluation / CI ----
# Set to true to avoid any provider API call (uses the simulated LLM).
SIMULATE_LLM=false
# Set to 1 to run real-model tests that download the ~1.3 GB BGE embedder.
# ANEXUS_RUN_REAL_TESTS=0