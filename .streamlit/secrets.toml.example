# ANexus Streamlit secrets — copy to .streamlit/secrets.toml (gitignored).
#
# This file configures:
#   1. the OIDC provider used for login (Streamlit native auth), and
#   2. the server-side secrets the app reads at startup.
#
# Docs: https://docs.streamlit.io/develop/concepts/connections/authentication

[auth]
# Where the provider redirects back to. For local development this is the
# Streamlit address plus /oauth2callback.
redirect_uri = "http://localhost:8501/oauth2callback"
# A long random string used to sign the session cookie. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"
# OAuth client credentials from your identity provider (e.g. Google Cloud console).
client_id = "REPLACE_WITH_CLIENT_ID"
client_secret = "REPLACE_WITH_CLIENT_SECRET"
# OIDC discovery document. This example targets Google:
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---- Application secrets (read at startup and copied into the environment) ----
# Passphrase for the per-user credential vault (any string; required to save keys).
ANEXUS_SECRET_KEY = "REPLACE_WITH_A_RANDOM_PASSPHRASE"
# The first login from this email becomes an admin.
ANEXUS_BOOTSTRAP_ADMIN_EMAIL = "you@example.com"
